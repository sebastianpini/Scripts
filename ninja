#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage:
  ./ninja <script> [args...]
  ./ninja <env> <script> [args...]
  ./ninja envs
  ./ninja scripts

Default customer setup:
  Fill in env/default.env, then run scripts without an environment argument.

Environments:
  default
  demo1
  demo2

Scripts:
  last-login     python/user/last_login.py         Technician last login report
  org-summary    python/organization/overview.py   Organization device summary report
  owner-devices  python/device/assign_owner.py     Assign all device owners to a technician

Examples:
  ./ninja last-login
  ./ninja org-summary
  ./ninja owner-devices
  ./ninja owner-devices --apply
  ./ninja demo1 last-login
  ./ninja demo2 org-summary
EOF
}

list_envs() {
  find "$ROOT_DIR/env" -maxdepth 1 -type f -name '*.env' -exec basename {} .env \; | sort
}

list_scripts() {
  cat <<'EOF'
last-login
org-summary
owner-devices
EOF
}

resolve_script() {
  case "$1" in
    last-login)
      echo "python/user/last_login.py"
      ;;
    org-summary)
      echo "python/organization/overview.py"
      ;;
    owner-devices)
      echo "python/device/assign_owner.py"
      ;;
    *)
      echo ""
      ;;
  esac
}

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

case "$1" in
  -h | --help | help)
    usage
    exit 0
    ;;
  envs)
    list_envs
    exit 0
    ;;
  scripts)
    list_scripts
    exit 0
    ;;
esac

if [[ -n "$(resolve_script "$1")" ]]; then
  ENV_NAME="default"
  SCRIPT_NAME="$1"
  shift
else
  if [[ $# -lt 2 ]]; then
    usage
    exit 1
  fi

  ENV_NAME="$1"
  SCRIPT_NAME="$2"
  shift 2
fi

SCRIPT_PATH="$(resolve_script "$SCRIPT_NAME")"

if [[ -z "$SCRIPT_PATH" ]]; then
  echo "Unknown script: $SCRIPT_NAME"
  echo
  echo "Available scripts:"
  list_scripts
  exit 1
fi

cd "$ROOT_DIR"
exec ./lib/run-with-env.sh "$ENV_NAME" python3 "$SCRIPT_PATH" "$@"
